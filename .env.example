# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL / PostGIS (docker compose) ---
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# When running the CLI outside docker compose, point it at the database directly:
# IRIS_DATABASE_URL=postgresql://iris:<password>@localhost:5432/iris

# --- Geocoding ---
# nominatim (OSM, policy-compliant, cached) with offline GeoNames fallback | offline | none
IRIS_GEOCODER=nominatim
# Nominatim's usage policy asks for a contact e-mail for bulk-ish use
IRIS_NOMINATIM_EMAIL=

# --- Harvest behaviour ---
IRIS_REQUEST_DELAY_SECONDS=1.5
IRIS_BIG_BOX_MIN_SQM=10000
IRIS_MIN_CLASSIFICATION_CONFIDENCE=0.5
# 0 = no limit
IRIS_MAX_DOCUMENTS_PER_RUN=0
HARVEST_INTERVAL_SECONDS=21600

# --- Web ---
# Public hostname for automatic HTTPS (Caddy + Let's Encrypt), e.g. 201-79-3-160.sslip.io.
# Leave unset to serve plain HTTP on port 80.
SITE_ADDRESS=
# Also serve this host (e.g. the server's bare IP) over plain HTTP; IPs cannot get a certificate.
PLAIN_HTTP_HOST=
# Optional HTTP basic auth for the dashboard (leave empty to disable)
IRIS_WEB_BASIC_AUTH_USER=
IRIS_WEB_BASIC_AUTH_PASSWORD=

# --- Logging ---
IRIS_LOG_LEVEL=INFO
# text | json
IRIS_LOG_FORMAT=text
